{
  "include": "~/.config/waybar/default.jsonc",
  "position": "bottom",
  "modules-left": ["hyprland/window"],
  "modules-right": ["tray", "niri/language"],
  "hyprland/window": {
    "format": "{}",
    "rewrite": {
      "(.*) — Mozilla Firefox": "🌎 $1",
      "spotify_player": "Spotify"
    },
    "separate-outputs": true
  },
  "tray": {
    "spacing": 4
  },
//   "hyprland/language": {
//     "format": "󰌌 {}"
//   }
  "niri/language": {
    "format": "󰌌 {}"
  }
}
