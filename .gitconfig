[init]
	defaultBranch = main
[user]
	name = itsmexxie
	email = wendy.plaskova05@gmail.com
        signingKey = ~/.ssh/id_ed25519.pub
[gpg]
        format = ssh
[commit]
        gpgsign = true
[tag]
        gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[core]
	editor = nano
